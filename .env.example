# ==============================================================================
# Configuração de Referência — PoC Laguna On-Premises
# Copie para .env antes de executar: cp .env.example .env
# ==============================================================================

# Versões das imagens base (fixar digests no manifesto experimental do TCC 2)
SPARK_IMAGE=apache/spark:3.5.3-python3
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:3.79

# Armazenamento de objetos S3 local (SeaweedFS)
S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=laguna_poc_access
S3_SECRET_KEY=laguna_poc_secret
S3_BUCKET_RAW=raw-data
S3_BUCKET_CLEAN=clean-data

# Conectividade Spark Standalone (Client Mode)
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_DRIVER_HOST=spark-driver
SPARK_DRIVER_PORT=7078
SPARK_BLOCKMANAGER_PORT=7079

# Limites explícitos de recursos por contêiner (calibrados para host de 7,5 GiB RAM / 8 threads:
# soma de mem_limit = 5,5 GiB < 80% da RAM física total)
SEAWEEDFS_CPUS=1.0
SEAWEEDFS_MEM_LIMIT=512m

SPARK_MASTER_CPUS=1.0
SPARK_MASTER_MEM_LIMIT=512m
SPARK_DAEMON_MEMORY=128m

SPARK_DRIVER_CPUS=2.0
SPARK_DRIVER_MEM_LIMIT=1536m
SPARK_DRIVER_MEMORY=512m
SPARK_EXECUTOR_MEMORY=512m

SPARK_WORKER_CPUS=2.0
SPARK_WORKER_MEM_LIMIT=1536m
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1g
